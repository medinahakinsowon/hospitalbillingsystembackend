# Copy to .env and fill in. NEVER commit .env or share these values in chat.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Include the database name, e.g. /hospital_billing
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hospital_billing?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

HOSPITAL_NUMBER_PREFIX=HN

# Used only by `npm run seed:admin`. Remove after the first admin exists.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
